<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{site_title}}</title>
<meta name="description" content="{{description}}">
<link rel="canonical" href="{{canonical}}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{site_title}}">
<meta property="og:description" content="{{og_description}}">
<!-- og:image 必须是绝对地址。域名含中文时用 punycode（本仓库由 tools/build-site.py 自动填） -->
<meta property="og:image" content="{{og_image}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<!-- 资源一律用绝对路径：任意路径都会返回本页，相对路径会在 /a/b 下失效 -->
<link rel="preload" as="image" type="image/webp" href="/ring.webp">
<link rel="preload" as="image" type="image/webp" href="/core.webp">
<noscript><meta http-equiv="refresh" content="3;url={{target_url}}"></noscript>
<style>
  :root {
    --bg: #fffbef;
    --fg: #3a2c00;
    --muted: #8f7a45;
    --ink: #fece0e;
    --track: rgba(254, 206, 14, .22);
    --card: #ffffff;
    --size: min(64vw, 44vh, 340px);
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15120a;
      --fg: #f6edd0;
      --muted: #a8996c;
      --track: rgba(254, 206, 14, .16);
      --card: #221d12;
    }
  }

  * { box-sizing: border-box; margin: 0; }
  body {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 24px 16px 56px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  main { display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center; }

  /* 校徽：白底圆盘 + 旋转文字环 + 不转的中心奶龙，外面一圈进度条 */
  .wrap { transition: transform .45s cubic-bezier(.5, 0, .75, 0), opacity .45s ease-in; }
  .badge { position: relative; width: var(--size); aspect-ratio: 1; }
  .badge::before { content: ""; position: absolute; inset: 1.4%; border-radius: 50%; background: #fff; }
  .badge img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .progress { position: absolute; inset: -5.5%; width: 111%; height: 111%; transform: rotate(-90deg); overflow: visible; }
  .progress circle { fill: none; stroke-width: 1.1; stroke-linecap: round; }
  .progress .track { stroke: var(--track); }
  .progress .bar { stroke: var(--ink); stroke-dasharray: 100; stroke-dashoffset: 100; }

  .copy { display: flex; flex-direction: column; align-items: center; gap: 10px; transition: opacity .3s, transform .3s; }
  h1 { font-size: clamp(26px, 7vw, 40px); font-weight: 800; letter-spacing: .12em; padding-left: .12em; }
  .status { font-size: clamp(14px, 4vw, 17px); }
  .dots i {
    display: inline-block; width: .3em; height: .3em; margin-left: .18em;
    border-radius: 50%; background: currentColor; vertical-align: middle;
    animation: dot 1s ease-in-out infinite;
  }
  .dots i:nth-child(2) { animation-delay: .15s; }
  .dots i:nth-child(3) { animation-delay: .3s; }
  .hint { font-size: 13px; color: var(--muted); }
  .hint a { color: inherit; }

  /* 右下角「关于」：打开时暂停倒计时 */
  .about-btn {
    position: fixed; right: max(8px, env(safe-area-inset-right)); bottom: max(8px, env(safe-area-inset-bottom));
    padding: 8px 10px; border: 0; background: none; color: var(--muted);
    font: inherit; font-size: 13px; cursor: pointer;
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px;
    transition: color .2s, text-decoration-color .2s, opacity .3s;
  }
  .about-btn:hover, .about-btn:focus-visible { color: var(--fg); text-decoration-color: currentColor; }
  .about {
    width: min(360px, calc(100vw - 32px)); margin: auto; padding: 0; border: 0; border-radius: 16px;
    background: var(--card); color: var(--fg); box-shadow: 0 18px 50px rgba(0, 0, 0, .25);
    cursor: auto; user-select: text;
  }
  .about[open] { animation: rise .25s ease-out; }
  .about::backdrop { background: rgba(20, 16, 5, .45); backdrop-filter: blur(3px); }
  .about-body { padding: 24px 22px 18px; }
  .about h2 { font-size: 18px; margin-bottom: 12px; }
  .about p { font-size: 14px; line-height: 1.7; }
  .about p + p { margin-top: 8px; }
  .about del { color: var(--muted); text-decoration-thickness: 4px; }
  .about code {
    padding: 1px 6px; border-radius: 6px; background: var(--track);
    font: inherit; font-weight: 700; white-space: nowrap;
  }
  .about form { margin-top: 18px; text-align: right; }
  .about form button {
    padding: 8px 18px; border: 0; border-radius: 999px; background: var(--ink); color: #3a2c00;
    font: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
  }

  .run .badge { animation: pop .7s cubic-bezier(.34, 1.56, .64, 1) backwards; }
  .run .core { animation: breathe 1.8s ease-in-out .7s infinite; }
  .run .bar { animation: fill var(--delay) linear forwards; }
  .run .copy { animation: rise .5s ease-out .15s backwards; }
  .paused .bar { animation-play-state: paused; }
  .leaving .wrap { transform: scale(1.18); opacity: 0; }
  .leaving .copy { opacity: 0; transform: translateY(8px); }
  .leaving .about-btn { opacity: 0; }

  @keyframes pop { from { transform: scale(.55) rotate(-25deg); opacity: 0; } }
  @keyframes breathe { 50% { transform: scale(1.03); } }
  @keyframes fill { to { stroke-dashoffset: 0; } }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  @keyframes dot { 0%, 100% { opacity: .25; transform: none; } 40% { opacity: 1; transform: translateY(-.25em); } }

  @media (prefers-reduced-motion: reduce) {
    .run .badge, .run .core, .run .copy, .dots i, .about[open] { animation: none; }
    .wrap, .copy { transition: none; }
  }
</style>
</head>
<body>
<main>
  <div class="wrap" aria-hidden="true">
    <div class="badge">
      <svg class="progress" viewBox="0 0 100 100">
        <circle class="track" cx="50" cy="50" r="49"/>
        <circle class="bar" cx="50" cy="50" r="49" pathLength="100"/>
      </svg>
      <img class="ring" src="/ring.webp" alt="" width="720" height="720">
      <img class="core" src="/core.webp" alt="" width="720" height="720">
    </div>
  </div>
  <div class="copy">
    <h1>{{site_title}}</h1>
    <p class="status">{{intro_line}} <strong>{{site_title}}</strong><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span></p>
    <p class="hint" id="hint">立即前往</p>
    <noscript><p class="hint"><a href="{{target_url}}">没有自动跳转？点这里</a></p></noscript>
  </div>
</main>
<button class="about-btn" id="about-btn" type="button" hidden>关于</button>
<dialog class="about" id="about" aria-labelledby="about-title">
  <div class="about-body">
    <h2 id="about-title">关于本站</h2>
    <p>{{about_p1}}</p>
    <!-- 想加鸣谢就改这一行，例如：奶龙形象取自群u xxx，十分感谢。 -->
    <p>{{about_p2}}</p>
    <form method="dialog"><button>知道了</button></form>
  </div>
</dialog>
<script>
(() => {
  const TARGET = '{{target_url}}';
  const stay = new URLSearchParams(location.search).has('stay'); // 演示用：不跳转，循环播放
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DELAY = reduce ? 1200 : 2600; // 停留多久后开始离场（ms）
  const EXIT = reduce ? 0 : 450;      // 离场动画时长，和 CSS 里 .wrap 的 transition 一致
  const SPIN = 4000;                  // 文字环转一圈（ms）

  const body = document.body;
  body.style.setProperty('--delay', DELAY + 'ms');
  if (stay) document.getElementById('hint').textContent += '（演示模式，不会真的跳转）';

  const ring = reduce ? null : document.querySelector('.ring').animate(
    [{ transform: 'rotate(0turn)' }, { transform: 'rotate(1turn)' }],
    { duration: SPIN, iterations: Infinity }
  );

  const aboutBtn = document.getElementById('about-btn');
  const about = document.getElementById('about');
  aboutBtn.hidden = false; // 没有 JS 时弹窗打不开，按钮也就不显示

  let timer, leaving, deadline, remaining;

  function arm(ms) {
    deadline = performance.now() + ms;
    timer = setTimeout(leave, ms);
  }

  function start() {
    leaving = false;
    body.classList.remove('run', 'leaving');
    void body.offsetWidth; // 重新触发 CSS 动画
    body.classList.add('run');
    if (ring) ring.playbackRate = 1;
    arm(DELAY);
  }

  function leave() {
    if (leaving) return;
    leaving = true;
    clearTimeout(timer);
    body.classList.add('leaving');
    if (ring) { // 离场时文字环越转越快
      const t0 = performance.now();
      requestAnimationFrame(function speedUp(now) {
        const k = Math.min(1, (now - t0) / EXIT);
        ring.playbackRate = 1 + 7 * k * k;
        if (k < 1) requestAnimationFrame(speedUp);
      });
    }
    setTimeout(stay ? start : () => location.replace(TARGET), stay ? EXIT + 600 : EXIT);
  }

  // 打开「关于」时暂停倒计时和进度条，关闭后从剩余时间继续
  aboutBtn.addEventListener('click', () => {
    if (leaving) return;
    clearTimeout(timer);
    remaining = Math.max(0, deadline - performance.now());
    body.classList.add('paused');
    about.showModal();
  });
  about.addEventListener('close', () => {
    body.classList.remove('paused');
    if (!leaving) arm(remaining);
  });
  about.addEventListener('click', e => { if (e.target === about) about.close(); }); // 点遮罩关闭

  // 点击或按键立即跳转；「关于」相关的操作和 Tab、修饰键除外
  const IGNORED_KEYS = ['Tab', 'Shift', 'Control', 'Alt', 'Meta'];
  function skip(e) {
    if (about.open || aboutBtn.contains(e.target)) return;
    if (e.type === 'keydown' && IGNORED_KEYS.includes(e.key)) return;
    leave();
  }
  addEventListener('pointerdown', skip);
  addEventListener('keydown', skip);
  start();
})();
</script>
</body>
</html>
